class node:
	def __init__(self, data):
		self.data = data
		self.next = None
		
class circular_q:
	def __init__(self):
		self.front = None
		self.rear = None
		
	def enqueue(self , value):
		new_node = node(value)
		
		if self.rear is None:
			new_node.next = new_node
			self.rear = new_node
			self.front = new_node
			return "enqueue completed"
		
		self.rear.next = new_node
		new_node.next = self.front
		self.rear = new_node
		return "enqueue completed"
		
	def dequeue(self):
		if not self.front:
			return "queue is empty"
			
		if self.rear == self.front:
			self.rear = None
			self.front = None
			return "dequeue completed , queue is empty now"
			
		self.front = self.front.next
		self.rear.next = self.front
		return "dequeue is completed"
		
	def peek(self):
		if not self.front:
			return "queue is empty"
		return self.front.data
		
	def is_empty(self):
		if not self.front:
			return "queue is empty"
		return "queue is not empty"
		
	def length(self):
		if not self.front:
			return 0
			
		t1= self.front
		count = 1
		while t1.next != self.front:
			count += 1
			t1 = t1.next
			
		return count
		
	def print_data(self):
		if not self.front:
			return "queue is empty"
			
		t1 = self.front
		while t1.next != self.front:
			print(t1.data)
			t1 = t1.next
		print(t1.data)

print("\n========== CIRCULAR QUEUE + LINKED LIST TESTING ==========")

